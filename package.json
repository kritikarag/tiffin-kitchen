{
  "name": "tiffin",
  "version": "0.1.0",
  "private": true,
  "main": "next.config.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test:agent": "tsx --env-file-if-exists=.env tests/agent.test.ts",
    "db:seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "labels": "tsx --env-file-if-exists=.env scripts/translate-labels.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15"
  }
}
