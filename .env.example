# Copy this file to .env and fill in your database details.
# Use either the single URL...
DATABASE_URL=mysql://user:password@127.0.0.1:3306/tiffin

# ...or the separate values (used only when DATABASE_URL is not set).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=tiffin

# Claude (needed for /owner)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# GoDaddy test environment (optional; without these, domain checks are simulated)
# GODADDY_API_KEY=
# GODADDY_API_SECRET=
